{
  "$id": "containsExampleOfWork.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contains example of work",
  "description": "Item in hand contains the work that is represented by the added entry in MARC 700/710/711/730 with Ind2=2.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "$ref": "gndSubjectUri.json"
      },
      "label": {
        "type": "string"
      },
      "creatorOfWork": {
        "type": "string"
      },
      "type": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Work"
          ]
        }
      },
      "instrumentation": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "musicalKey": {
        "type": "string"
      },
      "workNumbering": {
        "type": "string"
      }
    },
    "required": [
      "label"
    ]
  }
}
