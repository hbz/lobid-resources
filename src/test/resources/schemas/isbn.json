{
  "$id": "isbn.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISBN",
  "description": "The ISBN without hyphen of the resource. Index allow for search with and without hyphen.",
  "type": "array",
  "items": {
    "type": "string",
    "pattern": "^(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+){3})[0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+){4})[0-9]{17}$)(?:97[89]?)?[0-9]{1,5}?[0-9]+?[0-9]+?[0-9X]$"
  }
}
